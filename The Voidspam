local function StopAntiAim()
    if AntiAimConnection then
        AntiAimConnection:Disconnect()
        AntiAimConnection = nil
    end

    local Character = LocalPlayer.Character
    if not Character then return end

    local Neck

    for _, v in ipairs(Character:GetDescendants()) do
        if v:IsA("Motor6D") and v.Name == "Neck" then
            Neck = v
            break
        end
    end

    if Neck and Neck:GetAttribute("OriginalC0") then
        Neck.C0 = Neck:GetAttribute("OriginalC0")
    end
end

local function StartAntiAim()
    local Character = LocalPlayer.Character
    if not Character then return end

    local Neck

    for _, v in ipairs(Character:GetDescendants()) do
        if v:IsA("Motor6D") and v.Name == "Neck" then
            Neck = v
            break
        end
    end

    if not Neck then
        warn("No Neck Motor6D found!")
        return
    end

    local OriginalC0 = Neck.C0
    Neck:SetAttribute("OriginalC0", OriginalC0)

    local Rotation = 0

    AntiAimConnection = RunService.RenderStepped:Connect(function(dt)
        if not AntiAimEnabled then
            return
        end

        Rotation += math.rad(Settings.AntiAimSpeed) * dt

Neck.C0 = OriginalC0 * CFrame.Angles(
    math.rad(Settings.AntiAimPitch),
    Rotation + math.rad(Settings.AntiAimYaw),
    math.rad(Settings.AntiAimRoll)
)

    end)
end

